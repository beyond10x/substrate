{
  "$id": "urn:b10x:substrate-wire:0.24.0:capability",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "config_generation": {
      "maximum": 18446744073709551615,
      "minimum": 1,
      "type": "integer"
    },
    "driver": {
      "const": "host"
    },
    "driver_version": {
      "minLength": 1,
      "type": "string"
    },
    "facts": {
      "additionalProperties": false,
      "properties": {
        "events.pull": {
          "const": true
        },
        "events.retention-events": {
          "maximum": 18446744073709551615,
          "minimum": 1,
          "type": "integer"
        },
        "events.stream": {
          "const": true
        },
        "exec.argv-only": {
          "const": true
        },
        "exec.cgroup-kill": {
          "const": true
        },
        "exec.cgroup-limits": {
          "additionalProperties": false,
          "properties": {
            "cpu": {
              "const": true
            },
            "memory": {
              "const": true
            },
            "processes": {
              "const": true
            }
          },
          "required": [
            "processes",
            "memory",
            "cpu"
          ],
          "type": "object"
        },
        "exec.egress-apertures": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "destination": {
                "maxLength": 64,
                "minLength": 3,
                "type": "string"
              },
              "max_bytes": {
                "description": "The declared byte ceiling for one run over this aperture, both directions summed. Absent means unbounded (ADR 0014).",
                "minimum": 1,
                "type": "integer"
              },
              "name": {
                "maxLength": 64,
                "pattern": "^[a-z][a-z0-9_]{0,63}$",
                "type": "string"
              }
            },
            "required": [
              "name",
              "destination"
            ],
            "type": "object"
          },
          "maxItems": 4,
          "minItems": 1,
          "type": "array",
          "uniqueItems": true,
          "x-b10x-order": "sorted-utf8-bytewise",
          "x-b10x-published-only-from": "a-verified-mechanism-never-configuration"
        },
        "exec.inline-capsule": {
          "additionalProperties": false,
          "properties": {
            "max_file_bytes": {
              "const": {
                "$wire": "MAX_EXECUTION_CAPSULE_FILE_BYTES"
              }
            },
            "max_files": {
              "const": {
                "$wire": "MAX_EXECUTION_CAPSULE_FILES"
              }
            },
            "max_total_bytes": {
              "const": {
                "$wire": "MAX_EXECUTION_CAPSULE_BYTES"
              }
            },
            "mount": {
              "const": {
                "$wire": "EXECUTION_CAPSULE_MOUNT"
              }
            }
          },
          "required": [
            "mount",
            "max_files",
            "max_file_bytes",
            "max_total_bytes"
          ],
          "type": "object"
        },
        "exec.max-current": {
          "const": {
            "$wire": "MAX_CURRENT_EXECS"
          }
        },
        "exec.namespaces": {
          "additionalProperties": false,
          "properties": {
            "ipc": {
              "const": true
            },
            "mount": {
              "const": true
            },
            "network": {
              "const": true
            },
            "pid": {
              "const": true
            },
            "user": {
              "const": true
            },
            "uts": {
              "const": true
            }
          },
          "required": [
            "user",
            "mount",
            "pid",
            "ipc",
            "uts",
            "network"
          ],
          "type": "object"
        },
        "exec.no-egress": {
          "const": true
        },
        "exec.output-limit-bytes": {
          "maximum": 9223372036854775807,
          "minimum": 1,
          "type": "integer"
        },
        "exec.resource-usage": {
          "additionalProperties": false,
          "properties": {
            "block_io": {
              "description": "True only where the delegation root enables the io controller for exec cgroups; false means every usage record omits io_read_bytes and io_write_bytes (ADR 0032).",
              "type": "boolean"
            },
            "cpu_time": {
              "const": true
            },
            "memory_current": {
              "const": true
            },
            "memory_oom_kills": {
              "const": true
            },
            "memory_peak": {
              "const": true
            },
            "process_limit_hits": {
              "const": true
            },
            "processes_current": {
              "const": true
            },
            "processes_peak": {
              "const": true
            },
            "wall_time": {
              "const": true
            }
          },
          "required": [
            "wall_time",
            "cpu_time",
            "memory_current",
            "memory_peak",
            "processes_current",
            "processes_peak",
            "process_limit_hits",
            "memory_oom_kills",
            "block_io"
          ],
          "type": "object",
          "x-b10x-published-only-after": "cgroup-v2-counter-probe"
        },
        "exec.scratch-quota": {
          "additionalProperties": false,
          "properties": {
            "allocation_unit_bytes": {
              "const": 1024
            },
            "max_bytes": {
              "const": 1099511627776
            },
            "max_inodes": {
              "const": 1048576
            },
            "mount": {
              "const": "/scratch"
            }
          },
          "required": [
            "mount",
            "allocation_unit_bytes",
            "max_bytes",
            "max_inodes"
          ],
          "type": "object",
          "x-b10x-published-only-after": "project-quota-enforcement-probe"
        },
        "exec.signals": {
          "items": {
            "enum": [
              "INT",
              "TERM",
              "KILL"
            ]
          },
          "maxItems": 3,
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "leases.clock-tolerance-ms": {
          "const": {
            "$wire": "LEASE_CLOCK_TOLERANCE_MS"
          }
        },
        "leases.explicit": {
          "const": true
        },
        "metrics.stream": {
          "additionalProperties": false,
          "properties": {
            "latest_wins": {
              "const": true
            },
            "replay": {
              "const": false
            },
            "sample_interval_ms": {
              "const": 1000
            }
          },
          "required": [
            "sample_interval_ms",
            "latest_wins",
            "replay"
          ],
          "type": "object"
        },
        "operation.ledger-global-max-bytes": {
          "const": {
            "$wire": "OPERATION_LEDGER_GLOBAL_MAX_BYTES"
          }
        },
        "operation.ledger-global-max-rows": {
          "const": {
            "$wire": "OPERATION_LEDGER_GLOBAL_MAX_ROWS"
          }
        },
        "operation.ledger-subject-max-bytes": {
          "const": {
            "$wire": "OPERATION_LEDGER_SUBJECT_MAX_BYTES"
          }
        },
        "operation.ledger-subject-max-rows": {
          "const": {
            "$wire": "OPERATION_LEDGER_SUBJECT_MAX_ROWS"
          }
        },
        "secrets.slots": {
          "items": {
            "maxLength": 64,
            "pattern": "^[a-z][a-z0-9_]{0,63}$",
            "type": "string"
          },
          "maxItems": {
            "$wire": "MAX_SECRET_SLOTS"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true,
          "x-b10x-names-only": "no-path-no-length-no-digest",
          "x-b10x-order": "sorted-utf8-bytewise"
        },
        "sessions.pty": {
          "const": true,
          "x-b10x-absent-means": "every-pty-request-is-unserved-by-name",
          "x-b10x-published-only-after": "a-verified-allocation-in-a-throwaway-sandbox"
        },
        "snapshot.provenance-events": {
          "const": {
            "$wire": "MAX_SNAPSHOT_PROVENANCE_EVENTS"
          }
        },
        "workspace.atomic-replace": {
          "const": true
        },
        "workspace.guarded-io": {
          "const": true
        },
        "workspace.git": {
          "const": true,
          "x-b10x-absent-means": "Git workspace materialization is unserved",
          "x-b10x-published-only-after": "a-configured-HTTPS-source-and-local-git-mechanism-probe"
        },
        "workspace.list-limit-items": {
          "maximum": 18446744073709551615,
          "minimum": 1,
          "type": "integer"
        },
        "workspace.max-current": {
          "const": {
            "$wire": "MAX_CURRENT_WORKSPACES"
          }
        },
        "workspace.max-file-bytes": {
          "const": {
            "$wire": "MAX_FILE_BYTES"
          }
        },
        "workspace.openat2-beneath": {
          "const": true
        },
        "workspace.read-limit-bytes": {
          "maximum": 9223372036854775807,
          "minimum": 1,
          "type": "integer"
        },
        "workspace.storage-quota": {
          "additionalProperties": false,
          "properties": {
            "allocation_unit_bytes": {
              "const": 1024
            },
            "max_bytes": {
              "const": 1099511627776
            },
            "max_inodes": {
              "const": 1048576
            }
          },
          "required": [
            "allocation_unit_bytes",
            "max_bytes",
            "max_inodes"
          ],
          "type": "object",
          "x-b10x-published-only-after": "project-quota-enforcement-probe"
        },
        "exec.workspace-scoped-write": {
          "const": true
        },
        "sessions.unrecorded": {
          "type": "boolean",
          "description": "Driver supports capture-free bounded live output; daemon policy is separate."
        },
        "exec.read-only-files": {
          "additionalProperties": false,
          "properties": {
            "max_files": {
              "const": 16
            }
          },
          "required": [
            "max_files"
          ],
          "type": "object",
          "x-b10x-absent-means": "every-declared-read-only-file-is-unserved-by-name",
          "x-b10x-published-only-after": "a-pinned-file-bound-run-refused-a-write-and-found-alone-in-a-throwaway-sandbox"
        },
        "process.host": {
          "const": true,
          "description": "Whether this daemon serves host processes (ADR 0036 S2). A host process is unconfined and every record says so; this fact never selects a confined profile, and no confined request becomes a host process.",
          "x-b10x-absent-means": "every-process-start-is-process-host-unserved-and-nothing-runs",
          "x-b10x-never-published-in": [
            "static-bearer-tcp",
            "hosted-identity-admission",
            "network-session-authority"
          ],
          "x-b10x-published-only-after": "the-delegated-cgroup-v2-subtree-proved-usable-for-process-cgroups"
        },
        "exec.workdir": {
          "const": true,
          "description": "Whether this host starts a confined program in the working directory a start names (design 26 section 1).",
          "x-b10x-absent-means": "every-start-naming-a-workdir-is-exec-workdir-unserved",
          "x-b10x-published-only-after": "a-throwaway-sandbox-started-in-a-named-directory-and-refused-an-absent-one"
        },
        "exec.writable-roots.host": {
          "description": "The names of the writable host roots the operator declared (ADR 0038 decision 5). A start may name only a listed root.",
          "items": {
            "maxLength": 255,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_][A-Za-z0-9_-]*$",
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true,
          "x-b10x-absent-means": "every-start-naming-a-writable-host-root-is-exec-writable-roots-host-unserved",
          "x-b10x-published-only-after": "a-throwaway-sandbox-proved-a-root-bound-by-descriptor-writable-while-its-parent-is-not"
        },
        "exec.writable-roots.git": {
          "const": true,
          "description": "Whether this host binds a Git checkout workspace of the caller writable at a mount (ADR 0038 decision 5).",
          "x-b10x-absent-means": "every-start-naming-a-writable-git-root-is-exec-writable-roots-git-unserved",
          "x-b10x-published-only-after": "workspace.git-is-published-and-the-writable-root-probe-passed"
        },
        "exec.read-only-roots": {
          "additionalProperties": false,
          "description": "The most read-only host roots one start may name (ADR 0010).",
          "properties": {
            "max_roots": {
              "const": {
                "$wire": "MAX_READ_ONLY_ROOTS"
              }
            }
          },
          "required": [
            "max_roots"
          ],
          "type": "object",
          "x-b10x-absent-means": "a-start-naming-a-root-is-refused-exec-sandbox-unavailable-before-dispatch",
          "x-b10x-published-only-after": "the-confinement-floor-and-openat2-symlink-free-resolution-are-both-proven"
        },
        "events.stream-bounds": {
          "additionalProperties": false,
          "description": "The caps that bound concurrent event streams per subject and per deployment, the most an upgraded event stream lives, and the refusal a stream over a cap earns (ADR 0042). From the upgrade on, these caps and not the transport budget count the socket.",
          "properties": {
            "global": {
              "const": 64
            },
            "lifetime_ms": {
              "const": 3600000
            },
            "per_subject": {
              "const": 4
            },
            "refusal": {
              "const": "event.stream-capacity"
            }
          },
          "required": [
            "per_subject",
            "global",
            "lifetime_ms",
            "refusal"
          ],
          "type": "object"
        },
        "metrics.stream-bounds": {
          "additionalProperties": false,
          "description": "The caps that bound concurrent metrics streams per subject and per deployment, the most an upgraded metrics stream lives, and the refusal a stream over a cap earns (ADR 0042). From the upgrade on, these caps and not the transport budget count the socket.",
          "properties": {
            "global": {
              "const": 64
            },
            "lifetime_ms": {
              "const": 3600000
            },
            "per_subject": {
              "const": 4
            },
            "refusal": {
              "const": "metrics.stream-capacity"
            }
          },
          "required": [
            "per_subject",
            "global",
            "lifetime_ms",
            "refusal"
          ],
          "type": "object",
          "x-b10x-absent-means": "the-metrics-stream-is-unserved",
          "x-b10x-published-only-after": "metrics.stream-is-published"
        },
        "sessions.attachment-bounds": {
          "additionalProperties": false,
          "description": "The caps that bound concurrent session attachments per subject, per session and per deployment, the most an upgraded attachment lives, and the refusal an attachment over the per-subject or global cap earns; a second attachment to one session is refused session.already-attached (ADR 0042). From the upgrade on, these caps and not the transport budget count the socket.",
          "properties": {
            "global": {
              "const": 32
            },
            "lifetime_ms": {
              "const": 3600000
            },
            "per_session": {
              "const": 1
            },
            "per_subject": {
              "const": 16
            },
            "refusal": {
              "const": "session.attachment-capacity"
            }
          },
          "required": [
            "per_subject",
            "per_session",
            "global",
            "lifetime_ms",
            "refusal"
          ],
          "type": "object",
          "x-b10x-absent-means": "no-exec-runs-so-no-session-can-be-attached",
          "x-b10x-published-only-after": "exec.argv-only-is-published"
        }
      },
      "required": [
        "events.pull",
        "events.stream",
        "events.retention-events",
        "exec.max-current",
        "operation.ledger-global-max-bytes",
        "operation.ledger-global-max-rows",
        "operation.ledger-subject-max-bytes",
        "operation.ledger-subject-max-rows",
        "workspace.max-current",
        "snapshot.provenance-events"
      ],
      "type": "object"
    },
    "probed_at": {
      "$ref": "common.json#/$defs/timestamp"
    },
    "snapshot": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "valid_until": {
      "$ref": "common.json#/$defs/timestamp"
    }
  },
  "required": [
    "snapshot",
    "driver",
    "driver_version",
    "config_generation",
    "probed_at",
    "facts"
  ],
  "title": "Phase-3 machine capability snapshot",
  "type": "object"
}
