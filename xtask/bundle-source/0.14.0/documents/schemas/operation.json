{
  "$defs": {
    "base-properties": {
      "accepted_at": {
        "oneOf": [
          {
            "$ref": "common.json#/$defs/timestamp"
          },
          {
            "type": "null"
          }
        ]
      },
      "actor": {
        "minLength": 1,
        "type": "string"
      },
      "capability_snapshot": {
        "oneOf": [
          {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "grant_ref": {
        "description": "The declared grant this operation ran under, verbatim from a verified delegated context. Null when none was presented.",
        "maxLength": 512,
        "type": [
          "string",
          "null"
        ]
      },
      "operation": {
        "$ref": "common.json#/$defs/operation-id"
      },
      "operation_kind": {
        "$routes": "keyed-operation-kinds"
      },
      "outcome": {},
      "platform_principal": {
        "description": "The initiating platform principal, verbatim from a verified delegated context. Separate from principal, which keeps its process-id meaning.",
        "maxLength": 512,
        "type": [
          "string",
          "null"
        ]
      },
      "principal": {
        "type": [
          "string",
          "null"
        ]
      },
      "request_hash": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "resource": {
        "type": [
          "string",
          "null"
        ]
      },
      "state": {
        "enum": [
          "refused",
          "accepted",
          "unknown",
          "terminal"
        ]
      },
      "terminal_at": {
        "oneOf": [
          {
            "$ref": "common.json#/$defs/timestamp"
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "error-outcome": {
      "additionalProperties": false,
      "properties": {
        "error": {
          "$ref": "error.json#/$defs/detail"
        },
        "kind": {
          "const": "error"
        }
      },
      "required": [
        "kind",
        "error"
      ],
      "type": "object"
    },
    "success-outcome": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "success"
        },
        "result": {
          "anyOf": {
            "$routes": "keyed-result-refs"
          }
        }
      },
      "required": [
        "kind",
        "result"
      ],
      "type": "object"
    }
  },
