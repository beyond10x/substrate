      "code": "process.profile-unknown",
      "status": 422
    },
    {
      "class": "refused",
      "code": "process.argv-invalid",
      "status": 422
    },
    {
      "class": "refused",
      "code": "process.cwd-invalid",
      "status": 422
    },
    {
