      "status": 409
    },
    {
      "class": "refused",
      "code": "process.lease-invalid",
      "status": 422
    },
    {
      "class": "refused",
      "code": "process.keep-reason-required",
      "status": 422
    },
    {
      "class": "exhausted",
      "code": "process.limit-exceeded",
      "status": 429
    },
    {
      "class": "refused",
      "code": "process.timeout-invalid",
      "status": 422
    },
    {
      "class": "refused",
      "code": "process.expires-at-invalid",
      "status": 422
    }
  ],
  "x-b10x-requires-capability": "process.host"
}
