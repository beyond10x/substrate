{
  "bundle": "substrate-wire@0.1.0",
  "inputs": [
    {
      "name": "Daemonloom substrate contract",
      "origin": "daemonloom",
      "role": "wire semantics and conformance vectors",
      "version": "0.1.0"
    },
    {
      "name": "JSON Schema",
      "origin": "standard",
      "role": "schema vocabulary",
      "uri": "https://json-schema.org/draft/2020-12/schema",
      "version": "2020-12"
    },
    {
      "name": "JSON Canonicalization Scheme",
      "origin": "standard",
      "role": "operation input canonicalization",
      "uri": "https://www.rfc-editor.org/rfc/rfc8785.html",
      "version": "RFC 8785"
    },
    {
      "name": "JSON Pointer",
      "origin": "standard",
      "role": "clean-room runner postcondition addressing",
      "uri": "https://www.rfc-editor.org/rfc/rfc6901.html",
      "version": "RFC 6901"
    },
    {
      "name": "Base Encodings",
      "origin": "standard",
      "role": "bounded binary file and output content in JSON",
      "uri": "https://www.rfc-editor.org/rfc/rfc4648.html",
      "version": "RFC 4648"
    },
    {
      "name": "HTTP Semantics",
      "origin": "standard",
      "role": "method and status semantics",
      "uri": "https://www.rfc-editor.org/rfc/rfc9110.html",
      "version": "RFC 9110"
    },
    {
      "digest": null,
      "name": "OAuth 2.0 Bearer Token Usage",
      "origin": "standard",
      "release_blocker": "Pin approved source bytes or a standards trust record before release.",
      "role": "reachable TCP authorization header semantics",
      "uri": "https://www.rfc-editor.org/rfc/rfc6750.html",
      "version": "RFC 6750"
    },
    {
      "digest": null,
      "name": "OCI Image Specification",
      "origin": "standard",
      "release_blocker": "Pin the exact OCI 1.1 specification input and digest before release.",
      "role": "later signed contract-bundle packaging; not a phase-2 runtime dependency",
      "uri": "https://github.com/opencontainers/image-spec/tree/v1.1.1",
      "version": "1.1.1"
    },
    {
      "name": "WebSocket Protocol",
      "origin": "standard",
      "role": "later stream transport; no phase-2 WebSocket endpoint",
      "uri": "https://www.rfc-editor.org/rfc/rfc6455.html",
      "version": "RFC 6455"
    }
  ],
  "origin": "daemonloom"
}
