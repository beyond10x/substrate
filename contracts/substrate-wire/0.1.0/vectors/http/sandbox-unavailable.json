{
  "$schema": "../../schemas/vector.json",
  "assertions": [
    "response validates against schemas/error.json",
    "no process is spawned outside the requested sandbox",
    "the missing exec capability is absent from the next machine observation"
  ],
  "context": {
    "authenticated_subject": "local:1000"
  },
  "expected": {
    "class": "unserved",
    "code": "exec.sandbox-unavailable",
    "http_status": 501,
    "outcome": "unserved"
  },
  "id": "missing-sandbox-never-falls-back",
  "layer": "http",
  "phase": 2,
  "preconditions": [
    "bubblewrap or delegated cgroup probing failed before admission"
  ],
  "request": {
    "body": {
      "input": {
        "argv": [
          "/usr/bin/true"
        ],
        "env": {
          "allow": [],
          "set": {}
        },
        "sandbox": {
          "network": "none",
          "profile": "workspace",
          "require": true
        },
        "timeout_ms": 5000,
        "workspace": "ws_vector"
      },
      "op": "01JPHASE2SANDBOXABSENT"
    },
    "method": "POST",
    "path": "/v1/execs"
  }
}
