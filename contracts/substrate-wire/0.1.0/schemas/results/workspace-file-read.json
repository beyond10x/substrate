        },
        "kind": {
          "const": "file"
        },
        "next_offset": {
          "minimum": 0,
          "type": "integer"
        },
        "observed_at": {
          "$ref": "../common.json#/$defs/timestamp"
        },
        "offset": {
          "minimum": 0,
          "type": "integer"
        },
        "path": {
          "$ref": "../common.json#/$defs/relative-path"
        },
        "returned_bytes": {
          "minimum": 0,
          "type": "integer"
        },
