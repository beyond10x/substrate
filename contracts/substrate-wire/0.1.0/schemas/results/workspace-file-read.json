              }
            },
            "required": [
              "name",
              "kind",
              "size"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "kind": {
          "const": "directory"
        },
        "next_cursor": {
          "type": [
            "string",
            "null"
          ]
        },
        "observed_at": {
          "$ref": "../common.json#/$defs/timestamp"
        },
        "path": {
          "$ref": "../common.json#/$defs/relative-path"
