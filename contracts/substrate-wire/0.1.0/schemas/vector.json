{
  "$id": "urn:b10x:substrate-wire:0.1.0:vector",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "const": "../../schemas/vector.json"
    },
    "action": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "http"
            },
            "operation": {
              "type": "string"
            },
            "request": {
              "additionalProperties": false,
              "properties": {
                "body": {
                  "type": "object"
                },
                "headers": {
                  "type": "object"
                },
                "method": {
                  "enum": [
                    "GET",
                    "POST",
                    "PUT",
                    "DELETE"
                  ]
                },
                "path": {
                  "pattern": "^/v1/",
                  "type": "string"
                },
                "query": {
                  "type": "object"
                }
              },
              "required": [
                "method",
                "path",
                "query",
                "headers"
              ],
              "type": "object"
            },
            "valid_address": {
              "type": "boolean"
            },
            "valid_input": {
              "type": "boolean"
            }
          },
          "required": [
            "kind",
            "operation",
            "request",
            "valid_address",
            "valid_input"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "command": {
              "type": "object"
            },
            "kind": {
              "const": "driver"
            },
            "port": {
              "enum": [
                "machine",
                "workspace",
                "exec"
              ]
            }
          },
          "required": [
            "kind",
            "port",
            "command"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "raw-http"
            },
            "operation": {
              "type": "string"
            },
            "request": {
              "additionalProperties": false,
              "properties": {
                "body": {
                  "additionalProperties": false,
                  "properties": {
                    "repeat": {
                      "additionalProperties": false,
                      "properties": {
                        "count": {
                          "minimum": 1,
                          "type": "integer"
                        },
                        "octet_hex": {
                          "pattern": "^[0-9a-f]{2}$",
                          "type": "string"
                        }
                      },
                      "required": [
                        "octet_hex",
                        "count"
                      ],
                      "type": "object"
                    },
                    "sha256": {
                      "pattern": "^[0-9a-f]{64}$",
                      "type": "string"
                    }
                  },
                  "required": [
                    "repeat",
                    "sha256"
                  ],
                  "type": "object"
                },
                "headers": {
                  "type": "object"
                },
                "method": {
                  "enum": [
                    "GET",
                    "POST",
                    "PUT",
                    "DELETE"
                  ]
                },
                "path": {
                  "pattern": "^/v1/",
                  "type": "string"
                }
              },
              "required": [
                "method",
                "path",
                "headers",
                "body"
              ],
              "type": "object"
            }
          },
          "required": [
            "kind",
            "operation",
            "request"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "http-sequence"
            },
            "operation": {
              "type": "string"
            },
            "steps": {
              "items": {
                "additionalProperties": false,
                "properties": {
                  "request": {
                    "additionalProperties": false,
                    "properties": {
                      "body": {
                        "type": "object"
                      },
                      "headers": {
                        "type": "object"
                      },
                      "method": {
                        "enum": [
                          "GET",
                          "POST",
                          "PUT",
                          "DELETE"
                        ]
                      },
                      "path": {
                        "pattern": "^/v1/",
                        "type": "string"
                      },
                      "query": {
                        "type": "object"
                      }
                    },
                    "required": [
                      "method",
                      "path",
                      "query",
                      "headers",
                      "body"
                    ],
                    "type": "object"
                  },
                  "valid_input": {
                    "const": true
                  }
                },
                "required": [
                  "request",
                  "valid_input"
                ],
                "type": "object"
              },
              "minItems": 2,
              "type": "array"
            }
          },
          "required": [
            "kind",
            "operation",
            "steps"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "configuration": {
              "additionalProperties": false,
              "properties": {
                "authentication": {
                  "const": "none"
                },
                "listen": {
                  "minLength": 1,
                  "type": "string"
                },
                "tls": {
                  "const": false
                },
                "trusted_tunnel": {
                  "const": false
                }
              },
              "required": [
                "listen",
                "authentication",
                "tls",
                "trusted_tunnel"
              ],
              "type": "object"
            },
            "kind": {
              "const": "startup"
            }
          },
          "required": [
            "kind",
            "configuration"
          ],
          "type": "object"
        }
      ]
    },
    "context": {
      "additionalProperties": false,
      "properties": {
        "actor": {
          "type": "string"
        },
        "authority": {
          "enum": [
            "http-harness",
            "driver-harness"
          ]
        },
        "clock": {
          "$ref": "common.json#/$defs/timestamp"
        },
        "deployment": {
          "minLength": 1,
          "type": "string"
        },
        "subject": {
          "minLength": 1,
          "type": "string"
        },
        "transport": {
          "additionalProperties": false,
          "properties": {
            "authenticated": {
              "type": "boolean"
            },
            "kind": {
              "enum": [
                "unix",
                "tcp"
              ]
            },
            "reachable": {
              "type": "boolean"
            }
          },
          "required": [
            "kind",
            "authenticated",
            "reachable"
          ],
          "type": "object"
        }
      },
      "required": [
        "authority",
        "clock",
        "deployment",
        "subject"
      ],
      "type": "object"
    },
    "covers": {
      "items": {
        "type": "string"
      },
      "minItems": 0,
      "type": "array",
      "uniqueItems": true
    },
    "expected": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "http-response"
            },
            "response": {
              "additionalProperties": false,
              "properties": {
                "body": {
                  "type": "object"
                },
                "status": {
                  "maximum": 599,
                  "minimum": 200,
                  "type": "integer"
                }
              },
              "required": [
                "status",
                "body"
              ],
              "type": "object"
            }
          },
          "required": [
            "kind",
            "response"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "driver-outcome"
            },
            "outcome": {
              "type": "object"
            }
          },
          "required": [
            "kind",
            "outcome"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "startup-outcome"
            },
            "outcome": {
              "additionalProperties": false,
              "properties": {
                "code": {
                  "const": "daemon.startup-refused"
                },
                "message": {
                  "minLength": 1,
                  "type": "string"
                },
                "started": {
                  "const": false
                }
              },
              "required": [
                "started",
                "code",
                "message"
              ],
              "type": "object"
            }
          },
          "required": [
            "kind",
            "outcome"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "http-sequence"
            },
            "responses": {
              "items": {
                "additionalProperties": false,
                "properties": {
                  "body": {
                    "type": "object"
                  },
                  "status": {
                    "maximum": 599,
                    "minimum": 200,
                    "type": "integer"
                  }
                },
                "required": [
                  "status",
                  "body"
                ],
                "type": "object"
              },
              "minItems": 2,
              "type": "array"
            }
          },
          "required": [
            "kind",
            "responses"
          ],
          "type": "object"
        }
      ]
    },
    "id": {
      "pattern": "^[a-z][a-z0-9-]+$",
      "type": "string"
    },
    "layer": {
      "enum": [
        "http",
        "driver"
      ]
    },
    "phase": {
      "enum": [
        2,
        6
      ]
    },
    "postconditions": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "actual": {
            "pattern": "^/",
            "type": "string"
          },
          "expected": {},
          "operator": {
            "enum": [
              "equals",
              "not-equals",
              "lte",
              "gte"
            ]
          }
        },
        "required": [
          "actual",
          "operator",
          "expected"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "setup": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "kind": {
            "enum": [
              "backend",
              "crash",
              "daemon-authority",
              "daemon-config",
              "exec",
              "exec-output",
              "fault",
              "git-source",
              "machine",
              "network",
              "operation",
              "output",
              "path-shape",
              "process-tree",
              "transport",
              "workspace"
            ]
          },
          "name": {
            "minLength": 1,
            "type": "string"
          },
          "state": {}
        },
        "required": [
          "kind",
          "name",
          "state"
        ],
        "type": "object"
      },
      "type": "array"
    }
  },
  "required": [
    "$schema",
    "id",
    "phase",
    "layer",
    "covers",
    "context",
    "setup",
    "action",
    "expected",
    "postconditions"
  ],
  "title": "Substrate conformance vector",
  "type": "object"
}
