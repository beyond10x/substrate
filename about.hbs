<!-- Generated with cargo-about 0.9.1 from Cargo.lock and about.toml. -->
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>Substrate third-party licences</title>
<style>
body { font-family: sans-serif; max-width: 80rem; margin: 2rem auto; padding: 0 1rem; }
pre { white-space: pre-wrap; overflow-wrap: anywhere; border: 1px solid #bbb; padding: 1rem; }
</style>
</head>
<body>
<h1>Substrate third-party licences</h1>
<p>This file lists the licence texts selected for the locked Rust dependencies distributed with
the Substrate daemon. Substrate's own licence is distributed separately as <code>LICENSE</code>.</p>
<h2>Overview</h2>
<ul>
{{#each overview}}
<li><a href="#{{id}}">{{name}}</a> ({{count}})</li>
{{/each}}
</ul>
{{#each licenses}}
{{#if first_of_kind}}<h2 id="{{id}}">{{name}}</h2>{{/if}}
<h3>{{name}}</h3>
<p>Used by:</p>
<ul>
{{#each used_by}}
<li>{{crate.name}} {{crate.version}}{{#if crate.repository}} — <a href="{{crate.repository}}">source</a>{{/if}}</li>
{{/each}}
</ul>
<pre>{{text}}</pre>
{{/each}}
</body>
</html>
