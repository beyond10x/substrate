{
  "apiVersion": "v1",
  "items": [
    {
      "apiVersion": "networking.k8s.io/v1",
      "kind": "NetworkPolicy",
      "metadata": {
        "labels": {
          "app.kubernetes.io/managed-by": "b10x-substrate",
          "b10x-substrate/run": "substrate-run-00000000000000000000000000"
        },
        "name": "substrate-run-00000000000000000000000000",
        "namespace": "substrate-pod-golden"
      },
      "spec": {
        "podSelector": {
          "matchLabels": {
            "b10x-substrate/run": "substrate-run-00000000000000000000000000"
          }
        },
        "policyTypes": [
          "Ingress",
          "Egress"
        ]
      }
    },
    {
      "apiVersion": "v1",
      "kind": "Pod",
      "metadata": {
        "labels": {
          "app.kubernetes.io/managed-by": "b10x-substrate",
          "b10x-substrate/run": "substrate-run-00000000000000000000000000"
        },
        "name": "substrate-run-00000000000000000000000000",
        "namespace": "substrate-pod-golden"
      },
      "spec": {
        "activeDeadlineSeconds": 30,
        "automountServiceAccountToken": false,
        "containers": [
          {
            "args": [
              "-c",
              "echo hi $$PWD > out"
            ],
            "command": [
              "/bin/sh"
            ],
            "env": [
              {
                "name": "LANG",
                "value": "C.UTF-8"
              },
              {
                "name": "SUBSTRATE_CONFINEMENT_LOCAL",
                "value": "refuse"
              }
            ],
            "image": "docker.io/library/busybox@sha256:bdf57e528e45e4433820e045b29b4597825a1c9e38353532d90a01445013f82e",
            "imagePullPolicy": "IfNotPresent",
            "name": "run",
            "resources": {
              "limits": {
                "cpu": "500m",
                "ephemeral-storage": "1073741824",
                "memory": "67108864"
              },
              "requests": {
                "cpu": "500m",
                "ephemeral-storage": "1073741824",
                "memory": "67108864"
              }
            },
            "securityContext": {
              "allowPrivilegeEscalation": false,
              "capabilities": {
                "drop": [
                  "ALL"
                ]
              },
              "privileged": false,
              "readOnlyRootFilesystem": true,
              "runAsGroup": 65532,
              "runAsNonRoot": true,
              "runAsUser": 65532,
              "seccompProfile": {
                "type": "RuntimeDefault"
              }
            },
            "stdin": false,
            "tty": false,
            "volumeMounts": [
              {
                "mountPath": "/workspace",
                "name": "workspace"
              }
            ],
            "workingDir": "/workspace/src"
          }
        ],
        "enableServiceLinks": false,
        "hostIPC": false,
        "hostNetwork": false,
        "hostPID": false,
        "restartPolicy": "Never",
        "securityContext": {
          "runAsGroup": 65532,
          "runAsNonRoot": true,
          "runAsUser": 65532,
          "seccompProfile": {
            "type": "RuntimeDefault"
          }
        },
        "terminationGracePeriodSeconds": 5,
        "volumes": [
          {
            "emptyDir": {
              "sizeLimit": "1073741824"
            },
            "name": "workspace"
          }
        ]
      }
    }
  ],
  "kind": "List"
}
